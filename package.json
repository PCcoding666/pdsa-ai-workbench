{
  "name": "pdsa-ai-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -k -n api,web -c cyan,green \"node --env-file-if-exists=.env server/index.js\" \"vite --port 3001\"",
    "asr:preflight": "node --env-file-if-exists=.env scripts/asr-preflight.js",
    "asr:funasr:check": "node --env-file-if-exists=.env scripts/funasr-realtime.js --check",
    "asr:bloomberg": "node --env-file-if-exists=.env scripts/asr-worker.js --source bloomberg-tv",
    "asr:cnbc": "node --env-file-if-exists=.env scripts/asr-worker.js --source cnbc-live-tv",
    "capture:bloomberg": "node --env-file-if-exists=.env scripts/asr-capture.js --source bloomberg-tv",
    "capture:cnbc": "node --env-file-if-exists=.env scripts/asr-capture.js --source cnbc-live-tv",
    "asr:stack": "node --env-file-if-exists=.env scripts/asr-stack.js",
    "test:asr": "node --test test/asr-*.test.js test/funasr-realtime.test.js test/server-network-security.test.js",
    "audio:list": "node --env-file-if-exists=.env scripts/asr-capture.js --list-devices",
    "serenity:domains:once": "node scripts/serenity-domain-scheduler.js",
    "serenity:domains:dry-run": "node scripts/serenity-domain-scheduler.js --dry-run",
    "serenity:domains:watch": "node scripts/serenity-domain-scheduler.js --watch",
    "server": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^5.1.0",
    "rss-parser": "^3.13.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "lucide-react": "^0.545.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.11"
  }
}
