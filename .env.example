# Copy to .env only if you need local overrides. Never commit a real .env file.
# Node loads this file as literal key/value text: it does not expand ~, $HOME,
# or command substitutions. Use a full /Users/... path when a PATH command is not enough.

# Shared, non-secret ASR configuration.
ASR_SOURCE_CONFIG=config/asr-sources.json
ASR_API_BASE=http://127.0.0.1:3002
# Optional HTTP Basic credentials for the protected event API. ASR_API_* takes
# precedence; when both are empty, preflight and workers fall back to APP_*.
ASR_API_USERNAME=
ASR_API_PASSWORD=
# Existing server-wide Basic Auth names are also supported as a fallback when
# ASR_API_* is empty.
APP_USERNAME=
APP_PASSWORD=
ASR_INPUT_TIMEZONE=+08:00
ASR_SEGMENT_SECONDS=5
ASR_LANGUAGE=en
# DashScope FunASR realtime is the only default ASR backend. It streams the
# captured 16 kHz mono PCM segment to Model Studio; no local Whisper model is
# installed, downloaded, or used. The worker never writes this key to logs.
ASR_MODEL=fun-asr-realtime
ASR_BACKEND=funasr-realtime
DASHSCOPE_API_KEY=
# Leave the official endpoint unchanged unless testing against a local fixture.
DASHSCOPE_REALTIME_ENDPOINT=wss://dashscope.aliyuncs.com/api-ws/v1/inference
FUNASR_REALTIME_CHUNK_BYTES=3200
FUNASR_REALTIME_STARTUP_TIMEOUT_MS=20000
FUNASR_REALTIME_RESULT_TIMEOUT_MS=45000

# Tunable operational values.
ASR_MIN_AGE_MS=750
ASR_STABLE_CHECK_MS=250
ASR_POLL_MS=500
ASR_MAX_RETRIES=3
ASR_RETRY_BASE_MS=750
ASR_HTTP_TIMEOUT_MS=20000
ASR_TEXT_DEDUPE_WINDOW_MS=600000
ASR_DEDUPE_MAX_ENTRIES=50000
ASR_DEDUPE_RETENTION_MS=2592000000
ASR_DEDUPE_COMPACT_INTERVAL_MS=900000
ASR_SHUTDOWN_GRACE_MS=10000
ASR_SIGNAL_THRESHOLD_DB=-55

# Runtime storage is bounded by default. Set either retention day value to 0
# only if you intentionally manage archival/deletion elsewhere.
ASR_AUDIO_RETENTION_DAYS=7
ASR_FAILED_RETENTION_DAYS=30
ASR_RETENTION_CHECK_INTERVAL_MS=3600000
ASR_LOG_MAX_BYTES=10485760
ASR_LOG_MAX_ROTATED_FILES=5
